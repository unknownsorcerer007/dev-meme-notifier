# claude-code-wakeup — settings
#
# Edit the values below, save, and restart your agent (hooks load at session start).
# Anything you export as a real environment variable wins over what's here.
# Works with: Claude Code, Codex, Hermes, Goose, Aider.

# Wait this many seconds after the agent asks for you before sounding the alarm.
WAKEUP_DELAY_SECS="${WAKEUP_DELAY_SECS:-10}"

# ...and only sound it if you haven't touched the keyboard or mouse for this long.
# Bump this to 45 if you want it to stay quiet unless you're really gone.
WAKEUP_IDLE_SECS="${WAKEUP_IDLE_SECS:-10}"

# Which moments arm the alarm. Delete any you don't want woken up for.
#   permission_prompt  - agent is blocked waiting for you to approve a tool
#   idle_prompt        - agent's own "still there?" nudge
#   agent_needs_input  - agent is asking you a question mid-task
#   agent_completed    - a background agent finished
#   stop               - agent finished responding
WAKEUP_EVENTS="${WAKEUP_EVENTS:-permission_prompt idle_prompt agent_needs_input agent_completed stop}"

# Video to play. Empty = pick a random clip from media/, so you can drop in more alarms.
# Supports: .mp4, .mov, .avi, .mkv, .webm
WAKEUP_VIDEO="${WAKEUP_VIDEO:-}"

# Media player. "auto" picks the best available:
#   macOS:  ffplay > mpv > quicktime
#   Linux:  ffplay > mpv > vlc > xdg-open > totem
#   Windows: ffplay > mpv > wmplayer
# Or set explicitly: ffplay, mpv, vlc, quicktime, xdg-open, totem, wmplayer
WAKEUP_PLAYER="${WAKEUP_PLAYER:-auto}"

# Force system output volume to this (0-100) while the alarm plays, then put it back.
# Empty = leave your volume exactly as you left it.
WAKEUP_VOLUME="${WAKEUP_VOLUME:-}"

# 1 = keep replaying the video until you come back.
WAKEUP_LOOP="${WAKEUP_LOOP:-0}"

# Never play longer than this, no matter what.
WAKEUP_MAX_SECS="${WAKEUP_MAX_SECS:-120}"

# Idle seconds below this means you're back at the desk, so the alarm cuts out.
WAKEUP_RETURN_SECS="${WAKEUP_RETURN_SECS:-2}"

WAKEUP_LOG="${WAKEUP_LOG:-$HOME/.claude/wakeup.log}"
